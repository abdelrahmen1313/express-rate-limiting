{
    "name": "@edah/express-rate-limiting",
    "version": "1.0.9",
    "description": "Production-ready rate limiter middleware for Express.js",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "compile": "tsc -p tsconfig.build.json",
        "compile:watch": "tsc --watch -p tsconfig.build.json",
        "test": "tsc -p tsconfig.build.json && node --test \"test/*.test.js\"",
        "prepare": "npm run compile"
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "express": ">=4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abdelrahmen1313/express-rate-limiting.git"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "express": "^4.22.3",
        "typescript": "^5.9.3"
    },
    "license": "MIT",
    "keywords": [
        "express",
        "rate-limiter",
        "middleware",
        "typescript",
        "rate-limiting"
    ]
}
